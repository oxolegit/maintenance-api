{
  "name": "maintenance-api",
  "version": "1.0.0",
  "description": "REST API учёта заявок на обслуживание оборудования",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js | pino-pretty",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:undo": "node scripts/migrate.js down",
    "db:migrate:undo:all": "node scripts/migrate.js down --to 0",
    "db:migrate:status": "node scripts/migrate.js pending",
    "db:seed": "node scripts/seed.js up",
    "db:seed:undo": "node scripts/seed.js down",
    "db:seed:undo:all": "node scripts/seed.js down --to 0",
    "db:import": "node scripts/import-json.js"
  },
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2"
  }
}
