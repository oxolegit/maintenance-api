# Порт HTTP-сервера
PORT=3000

# Режим работы: development | test | production
# В production в ответах об ошибках нет стек-трейсов и внутренних сообщений
NODE_ENV=development

# Уровень логирования pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Разрешённые источники CORS через запятую (без "*"): адреса фронтендов, которым можно ходить в API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Ограничение частоты запросов к /api: окно в мс и максимум запросов с одного IP за окно
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Максимальный размер JSON-тела запроса
JSON_BODY_LIMIT=100kb

# PostgreSQL: из этих же переменных Docker Compose собирает контейнер db
# (внутри compose приложение ходит по DB_HOST=db, снаружи — localhost и опубликованный DB_PORT)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maintenance
DB_USER=maintenance
DB_PASSWORD=maintenance

# Пул соединений Sequelize и вывод SQL в лог на уровне debug (true | false)
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_LOG_SQL=false

# Отдельная база для автотестов; создаётся скриптом docker/initdb/01-test-db.sql
# при первой инициализации тома контейнера db
DB_NAME_TEST=maintenance_test

# Внешний погодный API (Open-Meteo) и таймаут одного HTTP-запроса к нему, мс
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000

# Прогноз: число дней по умолчанию (1-7) и правило пригодности окна для наружных работ:
# день пригоден, если осадки <= WEATHER_MAX_PRECIPITATION_MM и максимальный ветер <= WEATHER_MAX_WIND_SPEED_MS
WEATHER_FORECAST_DAYS=3
WEATHER_MAX_WIND_SPEED_MS=10
WEATHER_MAX_PRECIPITATION_MM=0

# Время жизни кэша прогноза в памяти, мс (0 — без кэша)
WEATHER_CACHE_TTL_MS=600000

# API-ключ для изменяющих операций (POST, PATCH, DELETE): передаётся в заголовке X-API-Key.
# Пустое значение отключает проверку (только для локальной разработки)
API_KEY=change-me
